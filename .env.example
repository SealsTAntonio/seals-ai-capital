# Values prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
# Use only the public Supabase URL and publishable/anon key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Route OpenAI requests through a trusted server or Supabase Edge Function.
# Never add an OpenAI API key to an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# "demo" uses clearly labeled local illustrative snapshots. "backend" is reserved for a
# future adapter served by EXPO_PUBLIC_API_BASE_URL; provider credentials belong on that server.
EXPO_PUBLIC_MARKET_DATA_MODE=demo

# "demo" is illustrative. "sec" retrieves public SEC EDGAR company facts. SEC asks automated
# clients to identify themselves; use an application name and monitored contact email (not a key).
EXPO_PUBLIC_FUNDAMENTAL_DATA_MODE=demo
EXPO_PUBLIC_SEC_USER_AGENT=SealsAICapital/2.1 your-email@example.com
