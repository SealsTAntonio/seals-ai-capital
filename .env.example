# Values prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
# Use only the public Supabase URL and publishable/anon key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Route OpenAI requests through a trusted server or Supabase Edge Function.
# Never add an OpenAI API key to an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
